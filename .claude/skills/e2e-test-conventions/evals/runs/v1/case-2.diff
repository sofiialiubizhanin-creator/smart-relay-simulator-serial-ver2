+"""AC-F1-10: hardware fault injection, error priority and recovery (requirements section 3, AC-F1-10)."""
+import pytest
+
+STATES = ["OFF", "ON"]
+
+
+@pytest.mark.ac("AC-F1-10")
+@pytest.mark.parametrize("cmd", ["ON", "OFF"])
+@pytest.mark.parametrize("initial", STATES)
+def test_ac_f1_10_switch_command_under_hw_fault_replies_err_hw_fault(host, control, initial, cmd):
+    """ON and OFF (including the already-current state) -> ERR HW_FAULT / 1, state unchanged."""
+    control.set_state(initial)
+    control.fault("HW_FAULT")
+    r = host(cmd)
+    assert (r.stdout, r.exit_code) == ("ERR HW_FAULT", 1)
+    assert control.get_state() == initial
+
+
+@pytest.mark.ac("AC-F1-10")
+@pytest.mark.parametrize("initial", STATES)
+def test_ac_f1_10_status_still_works_under_hw_fault(host, control, initial):
+    control.set_state(initial)
+    control.fault("HW_FAULT")
+    r = host("STATUS")
+    assert (r.stdout, r.exit_code) == (f"STATUS {initial}", 0)
+    assert control.get_state() == initial
+
+
+@pytest.mark.ac("AC-F1-10")
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ("on", "ERR UNKNOWN_CMD"),       # rule 4 (not an exact command) wins over rule 5 (HW_FAULT)
+        ("", "ERR EMPTY"),               # rule 2 wins over rule 5
+        ("A" * 33, "ERR TOO_LONG"),      # rule 3 wins over rule 5
+        ("ON" + " " * 31, "ERR TOO_LONG"),  # 33 B starting with ON: length checked before content/fault
+    ],
+    ids=["lowercase-on", "empty", "33-bytes", "ON-plus-31-spaces"],
+)
+@pytest.mark.parametrize("initial", STATES)
+def test_ac_f1_10_invalid_line_under_hw_fault_gets_own_error(host, control, initial, line, expected):
+    """Error priority: an invalid line keeps its own error, not ERR HW_FAULT; state unchanged."""
+    control.set_state(initial)
+    control.fault("HW_FAULT")
+    r = host(line)
+    assert (r.stdout, r.exit_code) == (expected, 1)
+    assert control.get_state() == initial
+
+
+@pytest.mark.ac("AC-F1-10")
+@pytest.mark.parametrize(("initial", "cmd", "expected_state"), [("OFF", "ON", "ON"), ("ON", "OFF", "OFF")])
+def test_ac_f1_10_commands_work_again_after_fault_none(host, control, initial, cmd, expected_state):
+    control.set_state(initial)
+    control.fault("HW_FAULT")
+    r = host(cmd)
+    assert (r.stdout, r.exit_code) == ("ERR HW_FAULT", 1)
+    assert control.get_state() == initial
+
+    control.fault("NONE")
+    r = host(cmd)
+    assert (r.stdout, r.exit_code) == ("OK", 0)
+    assert control.get_state() == expected_state
+    r = host("STATUS")
+    assert (r.stdout, r.exit_code) == (f"STATUS {expected_state}", 0)
