+"""F1 relay control: E2E tests (specs/2026-11-20-f1-relay-control; conventions: skill e2e-test-conventions)."""
+import pytest
+
+OPPOSITE = {"OFF": "ON", "ON": "OFF"}
+
+
+# ---------- AC-F1-10: hardware fault, error priority, recovery ----------
+@pytest.mark.ac("AC-F1-10")
+@pytest.mark.parametrize("cmd", ["ON", "OFF"])
+@pytest.mark.parametrize("initial", ["OFF", "ON"])
+def test_ac_f1_10_hw_fault_blocks_on_off(host, control, cmd, initial):
+    """Covers both the switching command and the already-in-that-state command: the fault always wins."""
+    control.set_state(initial)
+    control.fault("HW_FAULT")
+    r = host(cmd)
+    assert (r.stdout, r.exit_code) == ("ERR HW_FAULT", 1)
+    assert control.get_state() == initial
+
+
+@pytest.mark.ac("AC-F1-10")
+@pytest.mark.parametrize("initial", ["OFF", "ON"])
+def test_ac_f1_10_hw_fault_status_still_works(host, control, initial):
+    control.set_state(initial)
+    control.fault("HW_FAULT")
+    r = host("STATUS")
+    assert (r.stdout, r.exit_code) == (f"STATUS {initial}", 0)
+    assert control.get_state() == initial
+
+
+@pytest.mark.ac("AC-F1-10")
+@pytest.mark.parametrize("cmd, expected", [
+    ("on", "ERR UNKNOWN_CMD"),          # rule 4 (not an exact command) before rule 5 (HW_FAULT)
+    ("", "ERR EMPTY"),                  # rule 2 before rule 5
+    ("ON" + " " * 31, "ERR TOO_LONG"),  # 33 bytes: rule 3 before rule 5
+], ids=["lowercase-on", "empty", "33-bytes"])
+@pytest.mark.parametrize("initial", ["OFF", "ON"])
+def test_ac_f1_10_hw_fault_invalid_line_keeps_own_error(host, control, cmd, expected, initial):
+    control.set_state(initial)
+    control.fault("HW_FAULT")
+    r = host(cmd)
+    assert (r.stdout, r.exit_code) == (expected, 1)
+    assert control.get_state() == initial
+
+
+@pytest.mark.ac("AC-F1-10")
+@pytest.mark.parametrize("initial", ["OFF", "ON"])
+def test_ac_f1_10_fault_none_recovers(host, control, initial):
+    control.set_state(initial)
+    control.fault("HW_FAULT")
+    target = OPPOSITE[initial]
+    r = host(target)
+    assert (r.stdout, r.exit_code) == ("ERR HW_FAULT", 1)
+    assert control.get_state() == initial
+
+    control.fault("NONE")
+    r = host(target)
+    assert (r.stdout, r.exit_code) == ("OK", 0)
+    assert control.get_state() == target
