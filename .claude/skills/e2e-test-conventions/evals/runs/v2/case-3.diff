@@ -0,0 +1,25 @@
+"""E2E tests for F1: relay control and status (specs/2026-11-20-f1-relay-control, plan.md G5)."""
+import pytest
+
+
+@pytest.mark.ac("AC-F1-11")
+def test_ac_f1_11_silent_device_times_out_and_discards_command(host, control):
+    control.set_state("OFF")
+    control.silence(True)
+
+    r = host("ON", timeout=0.5)
+
+    assert (r.stdout, r.exit_code) == ("", 3)
+    assert r.stderr == "ERROR: no response from device within 0.5s"
+    # Bound counted from the moment the host sent the command (host log TX -> TIMEOUT), as the AC states.
+    # Not r.duration: that includes Python start-up of the host process.
+    assert r.sent, "the host never logged a TX line"
+    assert r.send_to_end is not None, "the host logged no TIMEOUT/ERROR after TX"
+    assert r.send_to_end <= 0.5 + 0.5, f"TX -> TIMEOUT took {r.send_to_end:.3f}s (limit 1.0s)"
+    assert control.get_state() == "OFF", "the command sent to a silent device must be discarded"
+
+    # Recovery: after SILENCE OFF, commands work normally again.
+    control.silence(False)
+    r = host("STATUS")
+    assert (r.stdout, r.exit_code) == ("STATUS OFF", 0)
+    assert control.get_state() == "OFF"
